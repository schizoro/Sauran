SENDGRID_API_KEY=your-sendgrid-api-key
MAIL_FROM=your-verified-sender@example.com
DAILY_API_KEY=your-daily-co-api-key

# Web Push (telefon/masaüstü bildirimleri) — anahtarlari uretmek icin: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
# mailto:ornek@alanadi.com veya https://alanadi.com (bos birakilirsa MAIL_FROM kullanilir)
VAPID_SUBJECT=mailto:you@example.com
